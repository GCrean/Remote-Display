<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light; values-night/themes.xml swaps the parent for dark. Edge-to-edge with a light-on-gradient status bar. -->
    <style name="Theme.RemoteDisplay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>
</resources>
